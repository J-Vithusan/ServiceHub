// Prisma schema for ServiceHub
// Provider: PostgreSQL (Compatible with Supabase, Neon, AWS RDS, Render, and local PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      Role      @default(CUSTOMER)
  phone     String?
  address   String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]

  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  services    Service[]

  @@index([slug])
}

model Service {
  id              String        @id @default(cuid())
  categoryId      String
  name            String
  slug            String        @unique
  description     String
  price           Float
  durationMinutes Int           @default(60)
  status          ServiceStatus @default(ACTIVE)
  imageUrl        String?
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
}

model Booking {
  id                 String        @id @default(cuid())
  userId             String
  serviceId          String
  bookingDate        DateTime
  timeSlot           String
  notes              String?
  totalPrice         Float
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  service            Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([serviceId])
  @@index([bookingDate, timeSlot])
  @@index([status])
}
