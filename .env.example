# Database Connection String
# PostgreSQL format (works with Supabase, Neon, AWS RDS, Render, or local PostgreSQL):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/servicehub?schema=public"

# For zero-config local testing with SQLite (optional):
# DATABASE_URL="file:./dev.db"

# JWT Secret for Session Authentication & Cookie Signing
JWT_SECRET="servicehub-ultra-secure-jwt-secret-key-32-chars-minimum-token!"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
